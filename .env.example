# ── Server-side (Nitro / Node) ─────────────────────────────────────────────
# Switch between local Azurite ('local') and real Azure Tables ('azure')
AZURE_TABLES_ENV=local

# Local Azurite connection string (used when AZURE_TABLES_ENV=local)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Azure Storage (used when AZURE_TABLES_ENV=azure)
AZURE_STORAGE_ACCOUNT_URL=https://<account>.table.core.windows.net
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── SSO / OIDC (server-side, runtime only) ────────────────────────────────
# When OIDC_AUTH_URL + OIDC_CLIENT_ID + OIDC_ISSUER + SESSION_SECRET are set,
# SSO is enforced on all write/admin routes. Leave blank for local dev (open access).
#
# All of these come from your enterprise IdP app registration page:
#
#   OIDC_ISSUER      — issuer identifier; must match the `iss` claim in the JWT
#                      (e.g. https://sso.company.com, https://login.microsoftonline.com/<tenant>/v2.0)
#   OIDC_AUTH_URL    — authorization endpoint (where users log in)
#   OIDC_TOKEN_URL   — token endpoint (authorization code → tokens)
#   OIDC_USERINFO_URL— userinfo endpoint (fetch user profile claims)
#   OIDC_JWKS_URL    — JWKS endpoint (JWT signature verification keys)
#   OIDC_LOGOUT_URL  — end-session endpoint (optional; clears the IdP SSO session)
#
#   OIDC_REDIRECT_URI — must match exactly what is registered in the IdP app
#                       e.g. https://mission-control.example.com/api/auth/callback
#
#   OIDC_POST_LOGOUT_URL — where to redirect after logout (defaults to /)
#   OIDC_SCOPES          — space-separated scopes (default: openid profile)
#   SESSION_SECRET       — min 32-char random string; encrypts session cookies
#                          generate with: openssl rand -hex 32

OIDC_ISSUER=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_JWKS_URL=
OIDC_LOGOUT_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_POST_LOGOUT_URL=http://localhost:3000
OIDC_SCOPES=openid profile
SESSION_SECRET=

# ── Client-side / Vite build-time ────────────────────────────────────────
# Which environment this deployment represents
# Allowed values: dev | stage | prod
APP_ENV=dev

# Base URLs of sibling deployments — used for cross-env navigation links in
# the sidebar. Omit or leave empty to hide that environment's link.
APP_DEV_URL=https://dev.mission-control.example.com
APP_STAGE_URL=https://stage.mission-control.example.com
APP_PROD_URL=https://mission-control.example.com
